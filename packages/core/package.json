{
  "name": "@watervein/core",
  "version": "0.1.52-dev.0",
  "description": "Watervein core package",
  "author": "KoHaRxnP",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm build:js && pnpm build:types",
    "build:js": "esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm --platform=browser --external:@watervein/* --minify-whitespace --minify-identifiers",
    "build:types": "dts-bundle-generator -o dist/index.d.ts src/index.ts --external-imports @watervein/* --no-check",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "engine",
    "watervein",
    "waterveinjs",
    "typescript",
    "javascript",
    "dag",
    "ecs",
    "nes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waterveinjs/watervein.git"
  },
  "bugs": {
    "url": "https://github.com/waterveinjs/watervein/issues"
  },
  "homepage": "https://github.com/waterveinjs/watervein#readme",
  "packageManager": "pnpm@11.21.0"
}
