{
  "name": "@watervein/monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "clean": "rimraf packages/*/dist",
    "build": "pnpm typecheck && pnpm run clean && pnpm --filter \"./packages/*\" run build",
    "typecheck": "pnpm --filter \"./packages/*\" exec tsc --noEmit",
    "bt": "pnpm build && pnpm test",
    "bench": "pnpm --filter @watervein/benchmark run dev",
    "example:counter": "pnpm --filter @watervein/example-counter run dev",
    "example:helloworld": "pnpm --filter @watervein/example-helloworld run dev",
    "example:smd": "pnpm --filter @watervein/example-smd run dev",
    "example:todo": "pnpm --filter @watervein/example-todo run dev",
    "example:counter:less": "pnpm --filter @watervein/example-counter run dev:less",
    "example:helloworld:less": "pnpm --filter @watervein/example-helloworld run dev:less",
    "example:todo:less": "pnpm --filter @watervein/example-todo run dev:less",
    "test": "NODE_OPTIONS=--expose-gc vitest run",
    "test:pnpm": "pnpm --filter \"./packages/*\" test",
    "test:watch": "NODE_OPTIONS=--expose-gc vitest",
    "bump": "node scripts/bump.js",
    "bump:patch": "node scripts/bump.js patch",
    "bump:minor": "node scripts/bump.js minor",
    "bump:major": "node scripts/bump.js major",
    "bump:dev": "node scripts/bump.js dev",
    "dowse:s": "cd dowsing/s && runghc Spec.hs",
    "dowse:s:loop": "node -e \"const n = process.argv[1] || 3; for(let i=0; i<n; i++) require('child_process').execSync('cd dowsing/s && runghc Spec.hs', {stdio: 'inherit'})\" --",
    "dowse:ddg": "cd dowsing/ddg && runghc Spec.hs",
    "dowse:ddg:loop": "node -e \"const n = process.argv[1] || 3; for(let i=0; i<n; i++) require('child_process').execSync('cd dowsing/ddg && runghc Spec.hs', {stdio: 'inherit'})\" --",
    "dowse:entity": "cd dowsing/entity && runghc Spec.hs",
    "dowse:entity:loop": "node -e \"const n = process.argv[1] || 3; for(let i=0; i<n; i++) require('child_process').execSync('cd dowsing/entity && runghc Spec.hs', {stdio: 'inherit'})\" --"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
